{
  "name": "website-check-windows",
  "version": "0.3.0",
  "private": true,
  "description": "Self-contained Windows homepage testing app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node smoke-test.js",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.websitecheck.app",
    "productName": "Website Check",
    "files": [
      "main.js",
      "test-engine.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browsers",
        "to": "browsers",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Website Check"
    }
  }
}
